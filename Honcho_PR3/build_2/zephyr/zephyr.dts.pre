 pwm3_sleep: pwm3_sleep {
  group1 {
   psels = <((((((1) * 32U) + (6)) & 0x3FU) << 0U) | ((22U & 0xFFFFU) << 16U))>,
     <((((((1) * 32U) + (2)) & 0x3FU) << 0U) | ((23U & 0xFFFFU) << 16U))>;
   low-power-enable;
  };
 };


};
# 7 "C:/poweredjack/PJ_unit/boards/arm/honcho_esl2_llu_pan1780/honcho_esl2_llu_pan1780.dts" 2

/ {
 model = "Honcho_ESL2_LLU_PAN1780";
 compatible = "stanley-black-decker,honcho-esl2-llu-pan1780";

 chosen {
  zephyr,sram = &sram0;
  zephyr,flash = &flash0;
  zephyr,code-partition = &slot0_partition;
 };

 leds {
  compatible = "gpio-leds";




  Blue_led: Blue_led {
   gpios = <&gpio0 8 (1 << 0)>;
   label = "BLE LED blue";
  };
  Drop_led: Drop_led {
   gpios = <&gpio0 13 (1 << 0)>;
   label = "Drop LED";
  };
  soc1: soc1 {
   gpios = <&gpio0 16 (1 << 0)>;
   label = "Battery SOC 1";

  };
  soc2: soc2 {
   gpios = <&gpio0 24 (1 << 0)>;
   label = "Battery SOC 2";

  };
  soc3: soc3 {
   gpios = <&gpio0 23 (1 << 0)>;
   label = "Battery SOC 3";

  };
  Slope_led: Slope_led {
   gpios = <&gpio1 07 (1 << 0)>;
   label = "Pendulum Slope Indication LED";

  };

 };

 interrupt {
  compatible = "gpio-keys";
  keypadint: keypadint {
   gpios = <&gpio0 20 ((1 << 5) | (0 << 0))>;
   label = "INT 1 from attiny";
  };
  v3p3detect: v3p3detect {
   gpios = <&gpio0 12 ((0 << 0))>;
   label = "3.3v LDO detection";
  };
  yawfault: yawfault {
   gpios = <&gpio0 21 ((0 << 0))>;
   label = "Fault for yaw motor driver";
  };
  vertfault: vertfault {
   gpios = <&gpio1 15 ((0 << 0))>;
   label = "Fault for vertical motor driver";
  };
  pendulumlock: pendulumlock {
   gpios = <&gpio0 4 ((1 << 5) | (0 << 0))>;
   label = "Pendulum lock switch for slope LED";
  };

 };

 outputs {
  compatible = "gpio-leds";
  motor_dir: motor_dir {
   gpios = <&gpio1 10 (0 << 0)>;
   label = "Vertical Motor Direction pin";
  };




  motor_vertEN: motor_vertEN {
   gpios = <&gpio1 12 (0 << 0)>;
   label = "Enable vertical motor driver";
  };
  motor_yawEN: motor_yawEN {
   gpios = <&gpio1 11 (0 << 0)>;
   label = "Enable Yaw motor driver";
  };
  motor_reset: motor_reset{
   gpios = <&gpio1 5 (0 << 0)>;
   label = "Motor driver reset pin";
  };
  Uart_TX: Uart_TX_28 {
            gpios = <&gpio0 28 (0 << 0)>;
            label = "UART TX";
        };

 };

 enables {
  compatible = "gpio-keys";
  Vbatpack_EN: Vbatpack_EN {
   gpios = <&gpio0 17 ((0 << 0))>;
   label = "Battery enable for volatge measurement";
  };
  LaserBuck_EN: LaserBuck_EN {
   gpios = <&gpio0 25 ((0 << 0))>;
   label = "Lasre buck converter Enable 8V";
  };
  MotorBuck_EN: MotorBuck_EN {
   gpios = <&gpio1 1 ((0 << 0))>;
   label = "Motor Buck Convertor Enable 14V";
  };
  BattTH_EN: BattTH_EN {
   gpios = <&gpio0 3 ((0 << 0))>;
   label = "Btthery Thermistor enable";
  };
  LaserLbias:LaserLbias {
   gpios = <&gpio1 4 ((0 << 0))>;
   label = "Bias current enable for level laser";
  };
  LaserP1bias:LaserP1bias {
   gpios = <&gpio1 3 ((0 << 0))>;
   label = "Bias current enable for plum 1 laser";
  };
  LaserP2bias:LaserP2bias {
   gpios = <&gpio0 19 ((0 << 0))>;
   label = "Bias current enable for plum 2 laser";
  };
  Uart_RX: Uart_RX_29 {
            gpios = <&gpio0 29 ((0 << 0))>;
            label = "UART RX";
        };
  Laser_PS_ADC: Laser_PS_ADC{
   gpios = <&gpio0 5 ((0 << 0))>;
            label = "LASERPSASDC";
  };
  PACK_ID_EN: PACK_ID_EN{
   gpios = <&gpio0 26 ((0 << 0))>;
            label = "pack ID";
  };
  VBatt_coin_EN: Vbatt_coin_EN{
   gpios = <&gpio0 27 ((0 << 0))>;
            label = "coin adc en";
  };
  Laser_Current: Laser_Current{
   gpios = <&gpio0 30 ((0 << 0))>;
            label = "laser cuurent";
  };
  Vbatt_coin_adc: Vbatt_coin_adc{
   gpios = <&gpio0 31 ((0 << 0))>;
            label = "coin adc";
  };
  LDO_EN: LDO_EN{
   gpios = <&gpio0 22 ((0 << 0))>;
            label = "LDO enable";
  };


 };

 pwm {
  compatible = "pwm-leds";
  plum1_pwm: plum1_pwm {
   pwms = <&pwm0 0 (((20) * 1000UL) * 1000UL) (1 << 0)>;
   label = "PWM control for plum1 laser";
  };

  plum2_pwm: plum2_pwm {
   pwms = <&pwm1 0 (((20) * 1000UL) * 1000UL) (1 << 0)>;
   label = "PWM control for plum2 laser";
  };

  level_pwm: level_pwm {
   pwms = <&pwm2 0 (((20) * 1000UL) * 1000UL) (1 << 0)>;
   label = "PWM control for level laser";
  };
  vert_motor_step: vert_motor_step {
   pwms = <&pwm3 0 (((20) * 1000UL) * 1000UL) (1 << 0)>;
   label = "PWM control for Vertical motor";
  };
  yaw_motor_step: yaw_motor_step {
   pwms = <&pwm3 1 (((20) * 1000UL) * 1000UL) (1 << 0)>;
   label = "PWM control for Yaw motor";
  };

 };

 zephyr,user{
  io-channels = <&adc 0>,<&adc 5>,<&adc 6>,<&adc 7>;
 };

 aliases {
  keypadint = &keypadint;
  battdetect = &v3p3detect;
  pendlck = &pendulumlock;
  bleled = &Blue_led;
  dropled = &Drop_led;
  slopeled = &Slope_led;
  vbaten = &Vbatpack_EN;
  battthen = &BattTH_EN;
  lbucken = &LaserBuck_EN;
  mbucken = &MotorBuck_EN;
  motordir = &motor_dir;
  motorverten = &motor_vertEN;
  motoryawen = &motor_yawEN;
  lvlbias = &LaserLbias;
  plm1bias = &LaserP1bias;
  plm2bias = &LaserP2bias;
  motorrst = &motor_reset;
  uarttx = &Uart_TX;
        uartrx = &Uart_RX;
  laserpsadc = &Laser_PS_ADC;
  packiden = &PACK_ID_EN;
  vbatcoinen = &VBatt_coin_EN;
  lasercurrent = &Laser_Current;
  vbattcoinadc = &Vbatt_coin_adc;
  ldoen = &LDO_EN;
 };
};

&gpio0 {
 status = "okay";
};

&gpio1 {
 status = "okay";
};

&spi1 {
 status = "okay";
 pinctrl-0 = <&spi1_default>;
 pinctrl-1 = <&spi1_sleep>;
 pinctrl-names = "default", "sleep";
 cs-gpios = <&gpio0 7 (1 << 0)>;
};

&pwm0 {
 status = "okay";
 pinctrl-0 = <&pwm0_default>;
 pinctrl-1 = <&pwm0_sleep>;
 pinctrl-names = "default", "sleep";
};

&pwm1 {
 status = "okay";
 pinctrl-0 = <&pwm1_default>;
 pinctrl-1 = <&pwm1_sleep>;
 pinctrl-names = "default", "sleep";
};

&pwm2 {
 status = "okay";
 pinctrl-0 = <&pwm2_default>;
 pinctrl-1 = <&pwm2_sleep>;
 pinctrl-names = "default", "sleep";
};

&pwm3 {
 status = "okay";
 pinctrl-0 = <&pwm3_default>;
 pinctrl-1 = <&pwm3_sleep>;
 pinctrl-names = "default", "sleep";
};



&adc {
 status = "okay";
};
# 290 "C:/poweredjack/PJ_unit/boards/arm/honcho_esl2_llu_pan1780/honcho_esl2_llu_pan1780.dts"
&uart1 {
 compatible = "nordic,nrf-uarte";
 current-speed = <38400>;
 status = "okay";
 pinctrl-0 = <&uart1_default>;
 pinctrl-1 = <&uart1_sleep>;
 pinctrl-names = "default", "sleep";
  };

  &i2c0 {
 status = "okay";
 pinctrl-0 = <&i2c0_default>;
 pinctrl-1 = <&i2c0_sleep>;
 clock-frequency = <100000>;
 pinctrl-names = "default", "sleep";

  };
# 359 "C:/poweredjack/PJ_unit/boards/arm/honcho_esl2_llu_pan1780/honcho_esl2_llu_pan1780.dts"
&flash0 {
 partitions {
  compatible = "fixed-partitions";
  #address-cells = <1>;
  #size-cells = <1>;

  boot_partition: partition@0 {
   label = "mcuboot";
   reg = <0x000000000 0x0000C000>;
  };
  slot0_partition: partition@c000 {
   label = "image-0";
   reg = <0x0000c000 0x00072000>;
  };
# 381 "C:/poweredjack/PJ_unit/boards/arm/honcho_esl2_llu_pan1780/honcho_esl2_llu_pan1780.dts"
  scratch_partition: partition@7e000 {
   label = "image-scratch";
   reg = <0x0007e000 0x00070000>;
  };
  datalog_partition: partition@ee000 {
   label = "datalog-area";
   reg = <0x000ee000 0x00006000>;
  };
  calibraion_parition: partition@f4000 {
   label = "calib-area";
   reg = <0x000f4000 0x00002000>;
  };
  variable_partition: partition@f6000{
   label = "laserstatus-area";
   reg = <0x000f6000 0x00002000>;
  };
  storage_partition: partition@f8000 {
   label = "storage";
   reg = <0x000f8000 0x00008000>;
  };
 };
};

&wdt0 {
 compatible= "nordic,nrf-wdt";
 status="okay";
};
