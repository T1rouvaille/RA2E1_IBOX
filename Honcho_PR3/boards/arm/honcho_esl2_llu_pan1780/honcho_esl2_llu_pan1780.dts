&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x000000000 0x0000C000>;
		};
		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 0x00072000>;
		};
		// slot1_partition: partition@7e000 {
		// 	label = "image-1";
		// 	reg = <0x7e000 0x72000>;
		// };
		// scratch_partition: partition@f0000 {
		// 	label = "image-scratch";
		// 	reg = <0xf0000 0xa000>;
		// };
		scratch_partition: partition@7e000 {
			label = "image-scratch";
			reg = <0x0007e000 0x00070000>;
		};
		datalog_partition: partition@ee000	{
			label = "datalog-area";
			reg = <0x000ee000 0x00006000>;
		};
		calibraion_parition: partition@f4000 {
			label = "calib-area";
			reg = <0x000f4000 0x00002000>;
		};
		variable_partition: partition@f6000{
			label = "laserstatus-area";
			reg = <0x000f6000 0x00002000>;
		};
		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 0x00008000>;
		};
	};
};

&wdt0 {
	compatible= "nordic,nrf-wdt";
	status="okay";
};
